# Feature flag: Data Descriptor step (src/components/StepsWizard.jsx,
# ProgressBar.jsx). Set to the literal string "false" to hide the step —
# e.g. in production while the feature is still being finished on main.
# Any other value (or leaving it unset) keeps it enabled; this is the
# default so dev/local setups don't need to configure anything.
# Must be prefixed VITE_ to be readable in the frontend bundle.
VITE_ENABLE_DATA_DESCRIPTOR =